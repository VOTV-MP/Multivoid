// version.rc.in -- the VERSIONINFO resource, configured by CMake (@ONLY).
//
// Identity IN the bytes (UE4SS_ARC WP-2 commit 3): with the versioned
// multivoid-<game>-<build>.dll filename retired, the DLL itself carries the
// Paper pair. ProductVersion/FileVersion strings hold the authoritative
// "<game target> b<build>" (the letter suffix of the game target cannot fit
// the numeric fields); deploy-mod.ps1 fail-closed compares ProductVersion
// against the pair the source tree declares, and a bug report's copied
// main.dll self-identifies in Explorer / PowerShell.

#include <winres.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @VOTVCOOP_TARGET_MAJOR@,@VOTVCOOP_TARGET_MINOR@,@VOTVCOOP_BUILD@,0
 PRODUCTVERSION @VOTVCOOP_TARGET_MAJOR@,@VOTVCOOP_TARGET_MINOR@,@VOTVCOOP_BUILD@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "ProductName", "Multivoid"
            VALUE "InternalName", "multivoid"
            VALUE "OriginalFilename", "main.dll"
            VALUE "FileDescription", "Multivoid - Voices of the Void co-op mod"
            VALUE "ProductVersion", "@VOTVCOOP_GAME_TARGET@ b@VOTVCOOP_BUILD@"
            VALUE "FileVersion", "@VOTVCOOP_GAME_TARGET@ b@VOTVCOOP_BUILD@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
