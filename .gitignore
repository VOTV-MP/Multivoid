site/

# ---- KEY MATERIAL -- global, deliberately NOT path-scoped ------------------------------------
# This repo is public, and a private key that reaches a commit lives in history: deleting it does
# not undo the exposure, so the key must be treated as compromised and rotated. The rule is
# therefore blanket and scoped by ARTIFACT KIND rather than by location -- a path-scoped key rule
# grows a new gap every time a subdirectory appears. To commit a genuinely public cert, force it:
# `git add -f <file>`.
*.pem
*.key
*.p12
*.pfx
*.jks
id_rsa
id_ed25519

# Staging for site screenshots awaiting approval; never committed.
ignore_folder/

# ---- EXTRACTED GAME ART -- copyrighted, not ours to redistribute ------------------------------
# Icons extracted from the game's cooked assets. The mod ships without any original game file
# (principle 1), and putting the art in the repository would be the same thing by another route.
kerfur skins icons/

# ---- Shortcuts and host reference material ---------------------------------------------------
# A rule is only enforced if it is in this file; check with `git check-ignore -v <path>`, never by
# reading a list that claims coverage.
*.lnk
ref_*vps*
imgui.ini
# Same list, the "prose only, NOT enforced" half -- enforced now for the same reason.
docs/QUESTION_FORM_*
tools/workflows/
# The agent-spawning playbook, same class as the working notes above.
docs/AGENT_SPAWNING.md

# ---- RESEARCH CORPUS -- private in place -----------------------------------------------------
# Point-in-time reverse-engineering notes, raw session logs, crash dumps and screenshots, none of
# it audited for host addresses or machine details. It follows the site/ pattern: the files stay on
# disk with their own inner git repo, so local pointers resolve and nothing is lost.
research/

# Security working notes. A public security document belongs in a root SECURITY.md instead.
docs/security/

# assets/paks is TRACKED: every release archive already carries these exact bytes, and the release
# workflow publishes from a fresh runner checkout, which would otherwise ship an archive that is
# structurally correct and content-incomplete. The negation is per-extension rather than a bare
# `!assets/paks/**`, so the global `*.pak` rule above keeps covering every other pak in the tree --
# the game's own, dev installs. Only this directory's contents are published.
!assets/paks/*.pak
!assets/paks/*.png
!assets/paks/README.md

# SUPPORT.md is the working source the public donation copy is cut from, including the cost
# arithmetic behind the suggested amounts -- a useful number for the author that reads as a quota
# on a public page. What ships is a subset. Note the filename is not neutral: GitHub gives a
# TRACKED SUPPORT.md a link from the community profile and the new-issue page, and ignoring it
# drops that link. If the link is wanted, add a second short tracked file rather than this one.
SUPPORT.md



# The known-weaknesses register, on the same terms as the security notes above.
docs/CRUTCHES.md

# Local-only, on the same terms as the registers above.
# sibling in this block: each file stays ON DISK, every local pointer resolves, none resolves on
# GitHub.
#   THUNDERSTORE.md -- the publishing runbook: operator knowledge, not user documentation. What a
#     player needs is docs/INSTALL.md and that stays public. This one works through per-asset
#     review considerations and the store rules that cannot be undone, so a public copy reads as a
#     map of where a release can be attacked or mis-filed.
docs/THUNDERSTORE.md

# ---- WORKING NOTES ARE LOCAL (CONTRIBUTING.md, "Documentation") -------------------------------
# The public tree is written for a player and a contributor. Notes addressed to the next
# development session -- ledgers, working discipline, work in flight, plans, point-in-time
# findings, session logs, archives, review templates -- stay on disk, out of the repository.
# The docs tree is an ALLOWLIST: everything under docs/ is local unless a line below names it.
# Publishing a doc is a deliberate act (add its `!docs/<file>` line); writing a working doc is
# free and safe by default. The files that left the tree stay on disk; history is not rewritten.
docs/**
!docs/ARCHITECTURE.md
!docs/CODE_MAP.md
!docs/COOP_DISPATCH_VISIBILITY.md
!docs/COOP_ENTITY_EXPRESSION_MAP.md
!docs/COOP_SYNC_DOCTRINE.md
!docs/CREDITS.md
!docs/DEVS_GAUNTLET.md
!docs/FEASIBILITY.md
!docs/INSTALL.md
!docs/README.md
!docs/RELEASE.md
!docs/RE_WORKFLOW.md
!docs/ROADMAP.md
!docs/SCOPE.md
!docs/STATUS.md
!docs/VOTV_UI_STYLE.md
!docs/devices.md
!docs/events-and-weather.md
!docs/join.md
!docs/master-server.md
!docs/npcs-and-kerfur.md
!docs/piles.md
!docs/players.md
!docs/props.md
!docs/signals.md
!docs/testing.md
!docs/ui.md
!docs/vehicles.md
!docs/versioning.md
!docs/voice-and-chat.md
reference/agency-agents/

